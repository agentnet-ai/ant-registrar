*.sql
*.dump

# -----------------------------
# Lock Files (Optional Strategy)
# -----------------------------
# If you want reproducible builds, KEEP package-lock.json.
# If not, uncomment below.
# package-lock.json


# Key material (never commit)
**/*_private.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.kdbx

# Common credential artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
